# Do not commit real values. Prefer `forge-studios keys set fal` or your OS keyring.
FAL_KEY=
FAL_IMAGE_MODEL=
# Built-in model profiles select image_urls vs image_url automatically. Leave unset
# unless configuring an unsupported custom endpoint.
FAL_IMAGE_REFERENCE_FIELD=
FAL_VIDEO_MODEL=fal-ai/ltx-2.3/image-to-video/fast
# LTX 2.3 fast uses these fields for approved start/end keyframes.
FAL_VIDEO_START_FRAME_FIELD=image_url
FAL_VIDEO_END_FRAME_FIELD=end_image_url
# Set only for video providers that accept extra references beyond start/end frames.
FAL_VIDEO_REFERENCE_FIELD=

# External physical executor, e.g. `forge-puppeteer execute --stage mock`
FORGE_PUPPETEER_CMD=
